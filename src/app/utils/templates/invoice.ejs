<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tour Booking Invoice</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
            color: #333;
        }
        
        .container {
            max-width: 600px;
            margin: 20px auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }
        
        .header h1 {
            font-size: 28px;
            margin-bottom: 5px;
        }
        
        .header p {
            font-size: 14px;
            opacity: 0.9;
        }
        
        .content {
            padding: 30px;
        }
        
        .greeting {
            font-size: 16px;
            margin-bottom: 20px;
            color: #333;
        }
        
        .invoice-number {
            background-color: #f9f9f9;
            padding: 15px;
            border-left: 4px solid #667eea;
            margin-bottom: 25px;
            border-radius: 4px;
        }
        
        .invoice-number strong {
            display: block;
            color: #667eea;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }
        
        .invoice-number span {
            font-size: 18px;
            color: #333;
            font-weight: 600;
        }
        
        .details-section {
            margin-bottom: 30px;
        }
        
        .details-title {
            font-size: 14px;
            font-weight: 700;
            color: #667eea;
            text-transform: uppercase;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #f0f0f0;
        }
        
        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .detail-row:last-child {
            border-bottom: none;
        }
        
        .detail-label {
            color: #666;
            font-size: 14px;
        }
        
        .detail-value {
            color: #333;
            font-weight: 600;
            font-size: 14px;
        }
        
        .tour-details {
            background-color: #f9f9f9;
            padding: 20px;
            border-radius: 6px;
            margin-bottom: 25px;
        }
        
        .tour-title {
            font-size: 16px;
            font-weight: 700;
            color: #333;
            margin-bottom: 12px;
        }
        
        .price-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 6px;
            margin-bottom: 25px;
            text-align: center;
        }
        
        .price-label {
            font-size: 12px;
            opacity: 0.9;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        
        .price-amount {
            font-size: 32px;
            font-weight: 700;
        }
        
        .footer {
            background-color: #f9f9f9;
            padding: 20px;
            text-align: center;
            border-top: 1px solid #e0e0e0;
            font-size: 12px;
            color: #666;
        }
        
        .footer p {
            margin: 5px 0;
        }
        
        .thank-you {
            text-align: center;
            font-size: 14px;
            color: #333;
            margin-bottom: 20px;
            font-weight: 600;
        }
        
        .button {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 12px 30px;
            text-decoration: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            margin-top: 15px;
        }
        
        .button:hover {
            opacity: 0.9;
        }
        
        @media (max-width: 600px) {
            .header {
                padding: 25px 15px;
            }
            
            .header h1 {
                font-size: 22px;
            }
            
            .content {
                padding: 20px;
            }
            
            .price-amount {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>Tour Booking Invoice</h1>
            <p>Thank you for your booking!</p>
        </div>
        
        <!-- Main Content -->
        <div class="content">
            <!-- Greeting -->
            <div class="greeting">
                Hello <strong><%= userName %></strong>,
                <p style="margin-top: 8px; line-height: 1.6;">
                    Your tour booking has been confirmed! Please find your invoice details below.
                </p>
            </div>
            
            <!-- Invoice Number -->
            <div class="invoice-number">
                <strong>Transaction ID</strong>
                <span><%= transactionId %></span>
            </div>
            
            <!-- Booking Details Section -->
            <div class="details-section">
                <div class="details-title">Booking Details</div>
                <div class="detail-row">
                    <span class="detail-label">Booking Date:</span>
                    <span class="detail-value"><%= new Date(bookingDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Number of Guests:</span>
                    <span class="detail-value"><%= guestCount %> <%= guestCount > 1 ? 'guests' : 'guest' %></span>
                </div>
            </div>
            
            <!-- Tour Details Section -->
            <div class="tour-details">
                <div class="details-title" style="margin-bottom: 12px; border: none;">Tour Information</div>
                <div class="tour-title"><%= tourTitle %></div>
            </div>
            
            <!-- Price Section -->
            <div class="price-section">
                <div class="price-label">Total Amount</div>
                <div class="price-amount">৳<%= totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
            </div>
            
            <!-- Thank You Message -->
            <div class="thank-you">
                We're excited for you to join us on this amazing tour experience!
            </div>
            
            <!-- Support Section -->
            <div style="background-color: #f0f7ff; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
                <p style="font-size: 13px; color: #333; margin-bottom: 8px;">
                    <strong>Need help?</strong>
                </p>
                <p style="font-size: 12px; color: #666; line-height: 1.6;">
                    If you have any questions about your booking or need assistance, please don't hesitate to contact our support team.
                </p>
            </div>
        </div>
        
        <!-- Footer -->
        <div class="footer">
            <p><strong>PH Tour Management</strong></p>
            <p>Your trusted travel partner for unforgettable experiences</p>
            <p style="margin-top: 15px; border-top: 1px solid #ddd; padding-top: 15px; color: #999;">
                © 2026 PH Tour Management. All rights reserved.
            </p>
        </div>
    </div>
</body>
</html>
